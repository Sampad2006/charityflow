# ─── CharityFlow Environment Configuration ───────────────────────────────
# Copy this file to `.env` and adjust values as needed.
# The app ships in SIMULATION MODE by default (no Stellar network required).
# Set the contract IDs below to switch the dashboard to LIVE TESTNET mode.

# Stellar network endpoints
VITE_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed Soroban contract IDs (C-form, leave empty to stay in simulation mode)
VITE_REGISTRY_CONTRACT_ID=
VITE_ESCROW_CONTRACT_ID=

# Contract wallet / escrow account shown for classic XLM donations.
# In live mode, leave this as the escrow contract's account if you donate
# directly; otherwise a dedicated escrow G-address.
VITE_ESCROW_WALLET=

# AI Agent demo keypair (DEV/ONLY — never ship a live secret key!).
# Used to locally sign `request_payout` transactions so the demo is
# fully end-to-end without needing a second wallet.
VITE_AGENT_PUBLIC_KEY=GCYXK5W4GFXTILMV3RHAB37ED26RRXY3RKXY5VDE5Y7VT53U3ZQPU7HQ
VITE_AGENT_SECRET_KEY=SA6V7XU56334AXWB7VPUHCXLH6APRDPOPOMNHO5XSFG7JJ2VHHEXM5VT

# Demo NGO wallet that the AI agent disburses aid to
VITE_NGO_WALLET=GBPH6W2GR5QPSWJIJUJEHLQP3G7AISRJTRSIDOQKNUSOJOXW37BEPLBU

# Google Gemini API key — leave empty to use the built-in simulated AI agent
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.0-flash
